#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

app_id=local.dingping.fixedsplit
system_app=/Applications/定屏.app
console_user="$(/usr/bin/stat -f '%Su' /dev/console)"
if [[ -z "$console_user" || "$console_user" == root || "$console_user" == loginwindow ]]; then
  echo '请从当前登录的 Mac 用户桌面启动安装器。' >&2
  exit 1
fi
console_uid="$(/usr/bin/id -u "$console_user")"
user_home="$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory | /usr/bin/sed 's/^NFSHomeDirectory: //')"
if [[ -z "$user_home" || ! -d "$user_home" ]]; then echo '找不到当前用户文件夹。' >&2; exit 1; fi

check_existing() {
  local app="$1" existing_id existing_version existing_build
  if [[ -L "$app" ]]; then echo "安装位置是符号链接，请先在 Finder 中核对：$app" >&2; exit 1; fi
  if [[ -e "$app" ]]; then
    if [[ ! -d "$app" ]]; then echo "安装位置被其他文件占用：$app" >&2; exit 1; fi
    existing_id="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist" 2>/dev/null || true)"
    if [[ "$existing_id" != "$app_id" ]]; then
      echo "同名应用并非定屏，请先在 Finder 中核对：$app" >&2
      exit 1
    fi
    existing_version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app/Contents/Info.plist" 2>/dev/null || true)"
    existing_build="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$app/Contents/Info.plist" 2>/dev/null || true)"
    if ! /usr/bin/awk -v old="$existing_version" -v oldbuild="$existing_build" 'BEGIN {
      n=split(old,a,"."); split("0.8.0",b,".");
      for(i=1;i<=3;i++) {if((a[i]+0)>(b[i]+0))exit 1; if((a[i]+0)<(b[i]+0))exit 0;}
      if(n>3 || (oldbuild+0)>20)exit 1;
    }'; then
      echo "检测到比本安装包更新的版本，已停止：$app" >&2
      exit 1
    fi
  fi
}
check_existing "$system_app"
check_existing "$user_home/Applications/定屏.app"

running="$(/usr/bin/pgrep -u "$console_uid" -x DingPing || true)"
if [[ -n "$running" ]]; then
  echo '定屏仍在运行。请从菜单栏定屏图标选择「退出定屏」，再点安装器中的「重新安装」。' >&2
  exit 1
fi

backup_root="$user_home/Library/Application Support/定屏/Backups"
/bin/mkdir -p "$backup_root"
for old in "$system_app" "$user_home/Applications/定屏.app"; do
  if [[ -d "$old" ]]; then
    backup="$(/usr/bin/mktemp -d "$backup_root/pkg.XXXXXX")"
    /usr/bin/ditto -c -k --sequesterRsrc --keepParent "$old" "$backup/previous.zip"
    /usr/bin/unzip -tq "$backup/previous.zip" >/dev/null
    /usr/sbin/chown -R "$console_user" "$backup"
    echo "已备份旧 App：$backup/previous.zip"
  fi
done
/usr/sbin/chown "$console_user" "$backup_root"
